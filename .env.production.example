# Production stack (docker-compose.yml). Paste into Dokploy > Environment. Reference: docs/environment.md
# Empty = fill in. Anything not listed keeps its default.

APP_NAME="RSP Industries"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rsp-industries.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

LOG_STACK=stderr,daily,sentry
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="RSP Industries"
MAIL_SUPPORT_ADDRESS=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=it_IT

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://rsp-industries.com/auth/google/callback

SHIPPING_RATES_DRIVER=spediamo
SHIPPING_TRACKING_DRIVER=manual
SHIPPING_TRACKING_SPEDIAMO_TOKEN=

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=
SENTRY_ORG=rsp-ik
SENTRY_PROJECT=php-laravel
SENTRY_URL=https://de.sentry.io

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPS_HEARTBEAT_URL=
