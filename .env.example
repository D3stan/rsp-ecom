# Local defaults. Reference: docs/environment.md. Deploy templates: .env.production.example, .env.sandbox.example
# Format: `# options:` lists the accepted values, `# KEY=value` is optional (value shown is the default).

# --- Application ---
APP_NAME=Laravel
# options: local | development | production
APP_ENV=local
APP_KEY=
# options: true | false
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# --- Seeded admin (production only) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Admin

# --- Logging ---
LOG_CHANNEL=stack
# options: any of single | daily | stderr | sentry, comma separated
LOG_STACK=daily
# options: Monolog\Formatter\JsonFormatter | (empty)
# LOG_STDERR_FORMATTER=
# options: debug | info | notice | warning | error | critical
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# --- Database ---
# options: sqlite | mysql | mariadb
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# --- Session, cache, queue ---
# options: database | redis | file | array
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# options: database | redis | sync
QUEUE_CONNECTION=database
# options: database | redis | file | array
CACHE_STORE=database
# CACHE_PREFIX=
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Redis (only when a driver above is redis) ---
# options: phpredis | predis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MEMCACHED_HOST=127.0.0.1

# --- Mail ---
# options: log | smtp | array | ses | postmark | resend
MAIL_MAILER=log
# options: null | smtp | smtps
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@your-domain"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS="support@your-domain"
# CONTACT_EMAIL="support@your-domain"

# --- Shipping: rates ---
# options: fake | spediamo | dvaexpress
SHIPPING_RATES_DRIVER=fake
# SHIPPING_DELIVERY_DAYS_MIN=3
# SHIPPING_DELIVERY_DAYS_MAX=5

# --- Shipping: tracking ---
# options: manual | null | spediamo | dvaexpress
SHIPPING_TRACKING_DRIVER=manual
# options: true | false
SHIPPING_TRACKING_AUTO_DELIVER=true
# SHIPPING_TRACKING_POLL_MINUTES=120
# SHIPPING_TRACKING_SLOW_AFTER_DAYS=7
# SHIPPING_TRACKING_SLOW_POLL_MINUTES=720
# SHIPPING_TRACKING_MAX_AGE_DAYS=45

# --- Shipping: labels ---
# options: true | false
# SHIPPING_LABELS_ENABLED=false
# options: spediamo
# SHIPPING_LABELS_DRIVER=spediamo
# SHIPPING_DEFAULT_PARCEL_WEIGHT_KG=1.0
# SHIPPING_SENDER_NAME=
# SHIPPING_SENDER_STREET=
# SHIPPING_SENDER_CITY=
# SHIPPING_SENDER_POSTAL_CODE=
# SHIPPING_SENDER_PROVINCE=
# SHIPPING_SENDER_COUNTRY=IT
# SHIPPING_SENDER_PHONE=
# SHIPPING_SENDER_EMAIL=

# --- Carrier: Spediamo ---
# SHIPPING_TRACKING_SPEDIAMO_URL=https://api.spediamo.it
# SHIPPING_TRACKING_SPEDIAMO_TOKEN=
# SHIPPING_TRACKING_SPEDIAMO_TIMEOUT=10

# --- Carrier: DVA Express ---
DVAEXPRESS_BASE_URL=https://api.easyparcel.it
DVAEXPRESS_API_KEY=
DVAEXPRESS_DEFAULT_VETTORE=SDAM
# DVAEXPRESS_TIMEOUT=10

# --- Stripe (Cashier) ---
STRIPE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_WEBHOOK_TOLERANCE=300
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=it_IT
CASHIER_LOGGER=stack
# options: true | false
# STRIPE_TAX_AUTOMATIC=true

# --- AWS (only with an s3 disk or ses mailer) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Google sign-in ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"

# --- Sentry ---
SENTRY_LARAVEL_DSN=
# options: production | sandbox
SENTRY_ENVIRONMENT=
# options: 0.0 to 1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_FRONTEND_DSN=
# SENTRY_RELEASE=
# Source maps, read at Docker build time only
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_URL=

# --- Operational alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPS_HEARTBEAT_URL=
# options: true | false
# OPS_TELEGRAM_EXCEPTION_ALERTS=true
# OPS_TELEGRAM_EXCEPTION_THROTTLE_MINUTES=15
# OPS_HEALTH_SCHEDULER_MAX_AGE_MINUTES=15
# OPS_INVARIANTS_ALERT_WINDOW_MINUTES=360
# OPS_PAYMENT_PENDING_HOURS=72
# OPS_PAID_WAITING_DAYS=3
# OPS_FAILED_EMAIL_HOURS=24
# OPS_WEBHOOK_GRACE_MINUTES=15
# OPS_PAYMENTS_WITHOUT_ORDERS=10
# OPS_NO_ORDERS_HOURS=0
# OPS_FUNNEL_MIN_BASELINE=20
# OPS_FUNNEL_MIN_RECENT=10
# OPS_FUNNEL_DROP_RATIO=0.4
# QUEUE_ALERT_MAX_JOB_AGE_MINUTES=10
# QUEUE_ALERT_FAILED_JOBS_THRESHOLD=10

VITE_APP_NAME="${APP_NAME}"
