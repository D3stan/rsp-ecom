APP_NAME=Laravel
# Local default. Production MUST use APP_ENV=production and APP_DEBUG=false (debug pages leak config and env values).
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Production only: `php artisan db:seed --force` creates this admin (no admin without both values; no demo users).
# Other environments seed the demo admin admin@example.com / password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Admin

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Transactional mail is sent by queue workers. With `database` a worker process
# (`php artisan queue:work`) and the scheduler (`php artisan schedule:work`) MUST be running
# in production, otherwise no email leaves the server. See docs/reports/email-operations.md.
# `sync` sends inside the request (local debugging only).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production MUST use a real transport (smtp, ses, postmark, ...). `log` and `array` only
# write mail to the log / memory; the app logs a loud warning at boot if production uses them.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Automated mail is sent From this no-reply address, without Reply-To.
# Use an address on a domain with SPF/DKIM/DMARC set up.
MAIL_FROM_ADDRESS="noreply@your-domain"
MAIL_FROM_NAME="${APP_NAME}"
# Monitored mailbox shown in every email ("write to us here") instead of replying.
MAIL_SUPPORT_ADDRESS="support@your-domain"
# Where contact-form messages are delivered (defaults to MAIL_SUPPORT_ADDRESS).
# CONTACT_EMAIL="support@your-domain"

# Carrier tracking module (see docs/shipping-tracking-module.md)
# manual = tracking links from config/shipping.php, no API (default) | null = tracking disabled | spediamo | <adapter name>
SHIPPING_TRACKING_DRIVER=manual
# When the carrier reports Delivered, mark the shipped order delivered and send the delivered email (false = admin does it)
SHIPPING_TRACKING_AUTO_DELIVER=true
# Polling (only for drivers that contact a carrier; needs the queue worker and the scheduler)
# SHIPPING_TRACKING_POLL_MINUTES=120
# SHIPPING_TRACKING_SLOW_AFTER_DAYS=7
# SHIPPING_TRACKING_SLOW_POLL_MINUTES=720
# SHIPPING_TRACKING_MAX_AGE_DAYS=45
# Spediamo adapter (SHIPPING_TRACKING_DRIVER=spediamo): static API bearer token from the Spediamo account
# SHIPPING_TRACKING_SPEDIAMO_URL=https://api.spediamo.it
# SHIPPING_TRACKING_SPEDIAMO_TOKEN=
# SHIPPING_TRACKING_SPEDIAMO_TIMEOUT=10
# Per-adapter settings live in config/shipping.php (tracking.drivers.<name>), fed from env, for example:
# SHIPPING_TRACKING_EXAMPLE_URL=
# SHIPPING_TRACKING_EXAMPLE_KEY=
# Webhooks (POST /webhooks/tracking/<driver>) answer 403 in production while the driver's webhook secret is empty:
# SHIPPING_TRACKING_EXAMPLE_WEBHOOK_SECRET=

# Label creation (app/Shipping/Labels, OFF by default; usually switched on from the admin settings instead of env).
# When on, the admin creates the shipment + label PDF through the carrier API instead of typing a tracking number.
# SHIPPING_LABELS_ENABLED=false
# SHIPPING_LABELS_DRIVER=spediamo
# SHIPPING_DEFAULT_PARCEL_WEIGHT_KG=1.0
# Sender address printed on the label (falls back to the store identity where empty):
# SHIPPING_SENDER_NAME=
# SHIPPING_SENDER_STREET=
# SHIPPING_SENDER_CITY=
# SHIPPING_SENDER_POSTAL_CODE=
# SHIPPING_SENDER_PROVINCE=
# SHIPPING_SENDER_COUNTRY=IT
# SHIPPING_SENDER_PHONE=
# SHIPPING_SENDER_EMAIL=
# The Spediamo label adapter reuses the tracking adapter's credentials above (SHIPPING_TRACKING_SPEDIAMO_TOKEN / _URL).

# Shipping rates calculation (fake | spediamo | dvaexpress)
SHIPPING_RATES_DRIVER=fake

# DVA Express adapter
DVAEXPRESS_BASE_URL=https://api.easyparcel.it
DVAEXPRESS_API_KEY=
DVAEXPRESS_DEFAULT_VETTORE=SDAM

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe API Keys (Laravel Cashier)
STRIPE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Cashier Configuration
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=it_IT
CASHIER_LOGGER=stack

# Additional Stripe Settings
STRIPE_MODEL=App\\Models\\User
STRIPE_WEBHOOK_TOLERANCE=300

# Tax Configuration (optional - uncomment to enable automatic tax calculation)
# STRIPE_TAX_AUTOMATIC=true

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"