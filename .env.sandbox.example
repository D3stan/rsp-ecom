# Sandbox stack (docker-compose.sandbox.yml). Paste into Dokploy > Environment. Reference: docs/environment.md
# Empty = fill in. Anything not listed keeps its default.

APP_NAME="RSP Sandbox"
APP_ENV=development
APP_KEY=
APP_DEBUG=true
APP_URL=https://test.rsp-industries.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

LOG_STACK=stderr,daily,sentry
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=rsp_sandbox
DB_USERNAME=rsp_user
DB_PASSWORD=sandbox_secret_pass

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=sandbox@rsp-industries.com
MAIL_FROM_NAME="RSP Sandbox Store"
MAIL_SUPPORT_ADDRESS=support@rsp-industries.com

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=it_IT

SHIPPING_RATES_DRIVER=spediamo
SHIPPING_TRACKING_DRIVER=manual
SHIPPING_TRACKING_SPEDIAMO_TOKEN=
SHIPPING_LABELS_ENABLED=false
DVAEXPRESS_API_KEY=

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=sandbox
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_AUTH_TOKEN=
SENTRY_ORG=rsp-ik
SENTRY_PROJECT=php-laravel
SENTRY_URL=https://de.sentry.io

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPS_HEARTBEAT_URL=
